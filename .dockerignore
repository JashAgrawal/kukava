# Dependencies and build output are produced inside the image.
node_modules
.next
out
coverage

# VCS and tooling metadata.
.git
.gitignore
.github
.vscode
.idea

# Local environment files. Only .env.example is copied in, if at all.
.env
.env.local
.env*.local

# Logs and editor noise.
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Docs and assets that are not needed to serve the app.
README.md
CHANGELOG.md
docs
examples
ai-helper

# Test-only configuration, kept out of the runtime image.
vitest.config.ts
vitest.setup.ts
test-utils
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx