# Every variable the app reads, with its default. The app runs with none of
# these set; they exist so deployments have a single documented place to look.

# --- Logging -----------------------------------------------------------------
# Threshold for the structured logger in lib/logger.ts.
# One of: debug | info | warn | error | silent
# Defaults to debug in development. Use warn or error in production to keep
# high-frequency scroll traces out of the logs.
LOG_LEVEL=info

# --- Error tracking ----------------------------------------------------------
# When set, errors are forwarded to a Sentry-compatible endpoint as well as
# being logged. Leave blank to log only.
NEXT_PUBLIC_SENTRY_DSN=

# Release identifier attached to reported errors, e.g. a git SHA.
NEXT_PUBLIC_SENTRY_RELEASE=

# Deployment environment name, e.g. production or staging.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# --- Next.js -----------------------------------------------------------------
# Canonical origin, used for absolute URLs in metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 to collect anonymous build telemetry. Disabled in Docker and CI.
NEXT_TELEMETRY_DISABLED=1